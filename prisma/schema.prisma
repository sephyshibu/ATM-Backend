// ATM CRM: sign-in, users, roles and permissions, settings and the change log.
//
// Data safety rules (design v1.1, section 9):
// - Nothing here is ever hard-deleted by the app. Users are deactivated, roles and list values are archived or
//   retired, role grants are revoked (kept with who and when), settings values are new versions.
// - audit_event is append-only: a database trigger refuses UPDATE and DELETE (src/prisma/db-hardening.service.ts).
// - Structure changes are made by adding tables or optional columns in new migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  invited
  active
  deactivated
}

// ---------------------------------------------------------------- People and sign-in

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  /// Always stored lower-case. The person must sign in with a Google account using this email.
  email              String     @unique
  name               String
  title              String     @default("")
  status             UserStatus @default(invited)
  /// Google's stable account id, set at first sign-in. A different Google account for the same email is refused.
  googleSub          String?    @unique @map("google_sub")
  invitedAt          DateTime?  @map("invited_at")
  invitedById        String?    @map("invited_by_id") @db.Uuid
  /// SHA-256 of the invite link's token: the raw token is only ever in the email.
  inviteTokenHash    String?    @unique @map("invite_token_hash")
  inviteExpiresAt    DateTime?  @map("invite_expires_at")
  activatedAt        DateTime?  @map("activated_at")
  lastSignInAt       DateTime?  @map("last_sign_in_at")
  deactivatedAt      DateTime?  @map("deactivated_at")
  deactivatedById    String?    @map("deactivated_by_id") @db.Uuid
  deactivationReason String?    @map("deactivation_reason")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  invitedBy     User?      @relation("UserInvitedBy", fields: [invitedById], references: [id])
  invitees      User[]     @relation("UserInvitedBy")
  deactivatedBy User?      @relation("UserDeactivatedBy", fields: [deactivatedById], references: [id])
  deactivated   User[]     @relation("UserDeactivatedBy")
  roles         UserRole[] @relation("UserRoleUser")
  rolesGranted  UserRole[] @relation("UserRoleGrantedBy")
  rolesRevoked  UserRole[] @relation("UserRoleRevokedBy")
  sessions      Session[]
  ownedBrands   Brand[]    @relation("BrandOwner")

  @@index([status])
  @@map("user")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  /// SHA-256 of the cookie value: a database leak doesn't hand out live sessions.
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  ip         String?
  userAgent  String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("session")
}

// ---------------------------------------------------------------- Roles and permissions

/// The permission catalogue. Kept in step with src/common/permissions.ts at start-up; keys are never removed,
/// only marked retired, so old role history stays readable.
model Permission {
  key         String    @id
  groupName   String    @map("group_name")
  label       String
  description String    @default("")
  sortOrder   Int       @default(0) @map("sort_order")
  retiredAt   DateTime? @map("retired_at")

  roles RolePermission[]

  @@map("permission")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String    @default("")
  /// Seeded roles: they can be edited but not archived.
  builtIn     Boolean   @default(false) @map("built_in")
  /// Grants nothing when APP_ENV=production (the Tester role).
  testOnly    Boolean   @default(false) @map("test_only")
  version     Int       @default(1)
  archivedAt  DateTime? @map("archived_at")
  archivedById String?  @map("archived_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedById String?   @map("updated_by_id") @db.Uuid

  permissions RolePermission[]
  users       UserRole[]

  @@map("role")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionKey], references: [key])

  @@id([roleId, permissionKey])
  @@map("role_permission")
}

/// A role held by a person. Taking a role away sets revoked_at; the row stays as history.
model UserRole {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  grantedAt   DateTime  @default(now()) @map("granted_at")
  grantedById String?   @map("granted_by_id") @db.Uuid
  revokedAt   DateTime? @map("revoked_at")
  revokedById String?   @map("revoked_by_id") @db.Uuid

  user      User  @relation("UserRoleUser", fields: [userId], references: [id])
  role      Role  @relation(fields: [roleId], references: [id])
  grantedBy User? @relation("UserRoleGrantedBy", fields: [grantedById], references: [id])
  revokedBy User? @relation("UserRoleRevokedBy", fields: [revokedById], references: [id])

  @@index([userId, revokedAt])
  @@index([roleId, revokedAt])
  @@map("user_role")
}

// ---------------------------------------------------------------- Settings

/// A configuration value the business can change (clocks, quiet period, revenue band...). Defined by the seed.
model SettingDefinition {
  key         String  @id
  groupName   String  @map("group_name")
  label       String
  description String  @default("")
  /// integer | text | month_day | time | boolean
  type        String
  unit        String  @default("")
  min         Int?
  max         Int?
  sortOrder   Int     @default(0) @map("sort_order")

  values SettingValue[]

  @@map("setting_definition")
}

/// Every value a setting has had. The current value is the highest version; rows are never changed.
model SettingValue {
  id          String   @id @default(uuid()) @db.Uuid
  key         String
  version     Int
  value       Json
  reason      String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by_id") @db.Uuid

  definition SettingDefinition @relation(fields: [key], references: [key])

  @@unique([key, version])
  @@map("setting_value")
}

/// A pick-list the business edits: categories, sub-categories, routing, reason codes.
model ListDefinition {
  key           String  @id
  label         String
  description   String  @default("")
  /// A child list (sub-category) hangs each value under a value of its parent list (category).
  parentListKey String? @map("parent_list_key")
  sortOrder     Int     @default(0) @map("sort_order")

  values ListValue[]

  @@map("list_definition")
}

model ListValue {
  id          String    @id @default(uuid()) @db.Uuid
  listKey     String    @map("list_key")
  /// A stable code the rest of the system stores (BE, SKINCARE). Never changes; the label can.
  code        String
  label       String
  description String    @default("")
  parentId    String?   @map("parent_id") @db.Uuid
  sortOrder   Int       @default(0) @map("sort_order")
  retiredAt   DateTime? @map("retired_at")
  retiredById String?   @map("retired_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedById String?   @map("updated_by_id") @db.Uuid

  list     ListDefinition @relation(fields: [listKey], references: [key])
  parent   ListValue?     @relation("ListValueParent", fields: [parentId], references: [id])
  children ListValue[]    @relation("ListValueParent")
  tagLinks RecordTag[]

  @@unique([listKey, code])
  @@index([listKey, retiredAt])
  @@map("list_value")
}

// ---------------------------------------------------------------- Change log and email

/// The append-only change log: every change and every sign-in. A trigger refuses UPDATE and DELETE.
model AuditEvent {
  id          BigInt   @id @default(autoincrement())
  at          DateTime @default(now())
  actorId     String?  @map("actor_id") @db.Uuid
  /// The person's name and email at the time, so the entry reads right even if they change later.
  actorLabel  String   @map("actor_label")
  section     String
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  before      String?
  after       String?
  reason      String?
  ip          String?

  @@index([at])
  @@index([section])
  @@index([entityType, entityId])
  @@map("audit_event")
}

/// Every email the system sends, kept as a record (and the only copy when MAIL_TRANSPORT=log).
model EmailOutbox {
  id        String    @id @default(uuid()) @db.Uuid
  to        String
  subject   String
  bodyText  String    @map("body_text")
  bodyHtml  String    @map("body_html")
  status    String    @default("queued")
  error     String?
  createdAt DateTime  @default(now()) @map("created_at")
  sentAt    DateTime? @map("sent_at")

  @@map("email_outbox")
}

// ---------------------------------------------------------------- Records: organisations, brands, people
//
// An organisation is the company or parent group; it has one or more brands. People belong to an organisation
// and are linked to the brands they work on. Nothing is deleted: records are archived (archived_at) and every
// change is in the change log. Category, sub-category, routing, tier, buying role and consent store the list
// value's code (list_value.code), which never changes even when its name does.

model Organisation {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  /// The company's own website, normalised (no https://, no www.). Optional; unique among active organisations.
  domain       String?
  /// ISO 3166-1 alpha-2, e.g. GB.
  hqCountry    String?   @map("hq_country")
  linkedinUrl  String?   @map("linkedin_url")
  notes        String    @default("")
  /// The bigger group this company belongs to: another organisation record. Optional.
  parentId     String?   @map("parent_id") @db.Uuid
  /// Registered legal name, e.g. "Glow Cosmetics Pvt Ltd". Used on agreements and invoices.
  legalEntity  String?   @map("legal_entity")
  /// Don't approach this company or any of its brands and people. Changing it needs a reason.
  excluded        Boolean   @default(false)
  exclusionReason String?   @map("exclusion_reason")
  excludedAt      DateTime? @map("excluded_at")
  excludedById    String?   @map("excluded_by_id") @db.Uuid
  /// Values of the organisation fields added in Settings → Fields, by field key.
  custom          Json      @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdById  String?   @map("created_by_id") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedById  String?   @map("updated_by_id") @db.Uuid
  archivedAt   DateTime? @map("archived_at")
  archivedById String?   @map("archived_by_id") @db.Uuid

  parent  Organisation?  @relation("OrganisationGroup", fields: [parentId], references: [id])
  members Organisation[] @relation("OrganisationGroup")
  brands  Brand[]
  people  Person[]

  @@index([name])
  @@index([domain])
  @@index([parentId])
  @@map("organisation")
}

model Brand {
  id               String    @id @default(uuid()) @db.Uuid
  organisationId   String    @map("organisation_id") @db.Uuid
  name             String
  /// The brand's website, normalised; unique among active brands (the duplicate check). Required unless
  /// Settings → Fields says otherwise; without one, duplicates are caught by name within the organisation.
  domain           String?
  categoryCode     String?   @map("category_code")
  subCategoryCode  String?   @map("sub_category_code")
  routingCode      String?   @map("routing_code")
  /// ISO 3166-1 alpha-2 of the home market.
  homeCountry      String?   @map("home_country")
  /// Home revenue in whole USD. For a range ("5–7M") this is the low end and homeRevenueMaxUsd the high end.
  homeRevenueUsd   BigInt?   @map("home_revenue_usd")
  homeRevenueMaxUsd BigInt?  @map("home_revenue_max_usd")
  revenueYear      Int?      @map("revenue_year")
  /// Asian markets where the brand already sells (ISO codes).
  asianMarketsLive String[]  @default([]) @map("asian_markets_live")
  tierCode         String?   @map("tier_code")
  /// The ATM person responsible for the brand.
  ownerId          String?   @map("owner_id") @db.Uuid
  /// manual | import | enquiry | referral
  source           String    @default("manual")
  /// Values of the brand fields added in Settings → Fields, by field key.
  custom           Json      @default("{}")
  /// The import that created it, if any.
  importBatchId    String?   @map("import_batch_id") @db.Uuid
  description      String    @default("")
  linkedinUrl      String?   @map("linkedin_url")
  createdAt        DateTime  @default(now()) @map("created_at")
  createdById      String?   @map("created_by_id") @db.Uuid
  updatedAt        DateTime  @updatedAt @map("updated_at")
  updatedById      String?   @map("updated_by_id") @db.Uuid
  archivedAt       DateTime? @map("archived_at")
  archivedById     String?   @map("archived_by_id") @db.Uuid
  /// The knowledge base: not_started | in_progress (facts missing or not verified) | verified (every required
  /// fact verified and fresh) | stale (verified, but a required fact is past its refresh date). Recalculated by
  /// the system whenever a fact changes and every day; never set by hand.
  kbStatus         String    @default("not_started") @map("kb_status")
  kbVerifiedAt     DateTime? @map("kb_verified_at")

  organisation Organisation  @relation(fields: [organisationId], references: [id])
  owner        User?         @relation("BrandOwner", fields: [ownerId], references: [id])
  people       BrandPerson[]
  products     Product[]
  leads        Lead[]
  dossiers     Dossier[]
  facts        Fact[]

  @@index([organisationId])
  @@index([kbStatus])
  @@index([domain])
  @@index([archivedAt])
  @@map("brand")
}

model Person {
  id             String    @id @default(uuid()) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  firstName      String    @map("first_name")
  lastName       String    @default("") @map("last_name")
  jobTitle       String    @default("") @map("job_title")
  /// Lower-case. Optional; unique among active people.
  email          String?
  /// unknown | verified | invalid (lemlist will set it later)
  emailStatus    String    @default("unknown") @map("email_status")
  phone          String?
  linkedinUrl    String?   @map("linkedin_url")
  country        String?
  buyingRoleCode String?   @map("buying_role_code")
  consentCode    String?   @map("consent_code")
  notes          String    @default("")
  /// Values of the person fields added in Settings → Fields, by field key.
  custom         Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdById    String?   @map("created_by_id") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at")
  updatedById    String?   @map("updated_by_id") @db.Uuid
  archivedAt     DateTime? @map("archived_at")
  archivedById   String?   @map("archived_by_id") @db.Uuid

  organisation Organisation  @relation(fields: [organisationId], references: [id])
  brands       BrandPerson[]

  @@index([organisationId])
  @@index([email])
  @@map("person")
}

/// Which people work on which brand. Unlinking sets removed_at; the row stays as history.
model BrandPerson {
  id          String    @id @default(uuid()) @db.Uuid
  brandId     String    @map("brand_id") @db.Uuid
  personId    String    @map("person_id") @db.Uuid
  /// The brand's main contact (one per brand).
  isPrimary   Boolean   @default(false) @map("is_primary")
  addedAt     DateTime  @default(now()) @map("added_at")
  addedById   String?   @map("added_by_id") @db.Uuid
  removedAt   DateTime? @map("removed_at")
  removedById String?   @map("removed_by_id") @db.Uuid

  brand  Brand  @relation(fields: [brandId], references: [id])
  person Person @relation(fields: [personId], references: [id])

  @@index([brandId, removedAt])
  @@index([personId, removedAt])
  @@map("brand_person")
}

// ---------------------------------------------------------------- Products and tags

/// A product of a brand, e.g. Garnier face wash. Category and sub-category are optional here: when empty, the
/// product takes the brand's.
model Product {
  id              String    @id @default(uuid()) @db.Uuid
  brandId         String    @map("brand_id") @db.Uuid
  name            String
  /// The brand's own product code, if known.
  sku             String?
  categoryCode    String?   @map("category_code")
  subCategoryCode String?   @map("sub_category_code")
  description     String    @default("")
  /// Values of the product fields added in Settings → Fields, by field key.
  custom          Json      @default("{}")
  /// manual | import
  source          String    @default("manual")
  importBatchId   String?   @map("import_batch_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  createdById  String?   @map("created_by_id") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedById  String?   @map("updated_by_id") @db.Uuid
  archivedAt   DateTime? @map("archived_at")
  archivedById String?   @map("archived_by_id") @db.Uuid

  brand Brand @relation(fields: [brandId], references: [id])

  @@index([brandId, archivedAt])
  @@map("product")
}

/// A tag (a value of the "tag" list) on an organisation, a brand or a product. Taking a tag off sets removed_at;
/// the row stays as history.
model RecordTag {
  id          String    @id @default(uuid()) @db.Uuid
  tagId       String    @map("tag_id") @db.Uuid
  /// organisation | brand | product
  entityType  String    @map("entity_type")
  entityId    String    @map("entity_id") @db.Uuid
  addedAt     DateTime  @default(now()) @map("added_at")
  addedById   String?   @map("added_by_id") @db.Uuid
  removedAt   DateTime? @map("removed_at")
  removedById String?   @map("removed_by_id") @db.Uuid

  tag ListValue @relation(fields: [tagId], references: [id])

  @@index([entityType, entityId, removedAt])
  @@index([tagId, removedAt])
  @@map("record_tag")
}

// ---------------------------------------------------------------- Custom fields and imports

/// A field added in Settings → Fields for organisations, brands, products or people. Values live in the record's `custom` JSON under
/// `key`. The key and type never change once made (so stored values keep their meaning); a field is retired,
/// never deleted.
model CustomField {
  id           String    @id @default(uuid()) @db.Uuid
  /// organisation | brand | product | person
  entityType   String    @map("entity_type")
  /// Stable, e.g. shelf_life_months.
  key          String
  label        String
  /// text | long_text | number | date | yes_no | choice | multi_choice
  type         String
  /// For choice and multi_choice.
  options      String[]  @default([])
  required     Boolean   @default(false)
  help         String    @default("")
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdById  String?   @map("created_by_id") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedById  String?   @map("updated_by_id") @db.Uuid
  retiredAt    DateTime? @map("retired_at")
  retiredById  String?   @map("retired_by_id") @db.Uuid

  @@unique([entityType, key])
  @@map("custom_field")
}

/// A saved column mapping for imports (e.g. "Brand Register v3"): which file heading goes to which field. Picked
/// automatically when a file has the same headings. Retired, never deleted.
model ImportMapping {
  id          String    @id @default(uuid()) @db.Uuid
  /// brands | products
  kind        String
  name        String
  /// The file's headings when it was saved, to recognise the same register next time.
  headers     String[]  @default([])
  /// File heading → field key.
  mapping     Json      @default("{}")
  /// Field key → { cell value (lower case) → the value it stands for }, e.g. tier: { "a": "Tier 1" }.
  valueMaps   Json      @default("{}") @map("value_maps")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedById String?   @map("updated_by_id") @db.Uuid
  retiredAt   DateTime? @map("retired_at")

  @@unique([kind, name])
  @@map("import_mapping")
}

/// One Excel or CSV import: what was mapped, how many rows came in, and every rejected row with its reasons.
model ImportBatch {
  id            String   @id @default(uuid()) @db.Uuid
  /// brands | products
  kind          String
  /// For product imports: the brand the products went into.
  brandId       String?  @map("brand_id") @db.Uuid
  fileName      String   @map("file_name")
  /// Column → field, as chosen on the mapping step.
  mapping       Json     @default("{}")
  rowCount      Int      @map("row_count")
  createdCount  Int      @map("created_count")
  rejectedCount Int      @map("rejected_count")
  /// [{ row, reasons }] for every row that was not imported.
  rejected      Json     @default("[]")
  createdAt     DateTime @default(now()) @map("created_at")
  createdById   String?  @map("created_by_id") @db.Uuid
  /// The original Excel/CSV file, kept in S3 at <prefix>/imports/<kind>/<yyyy-mm>/<batch id>/<random id>.<ext>.
  /// Empty for imports made before files were kept, or while storage isn't set up.
  fileKey       String?   @unique @map("file_key")
  /// xlsx | csv
  fileType      String?   @map("file_type")
  fileSizeBytes Int?      @map("file_size_bytes")
  fileSha256    String?   @map("file_sha256")
  /// stored | failed
  fileStatus    String?   @map("file_status")
  fileStatusNote String?  @map("file_status_note")
  fileStoredAt  DateTime? @map("file_stored_at")

  @@index([kind, createdAt])
  @@map("import_batch")
}

// ---------------------------------------------------------------- Leads (the journey engine)

/// One brand in one journey (a quarter's campaign, an enquiry). Stages live on the lead, never on the brand.
/// `stage` is the main stage (register → target → contacted → warm → hot → sql); `lane` is a side lane the lead
/// is parked in (nurture, parked, on_hold…), with `stage` kept so it can return. Only the journey engine changes
/// these, and every change is a lead_move row.
model Lead {
  id             String    @id @default(uuid()) @db.Uuid
  brandId        String    @map("brand_id") @db.Uuid
  /// The main contact for this journey.
  personId       String?   @map("person_id") @db.Uuid
  /// outbound | enquiry | referral | investor
  source         String    @default("outbound")
  stage          String
  lane           String?
  /// Return or recheck date for the lane (nurture, parked, on hold), as a date.
  laneUntil      DateTime? @map("lane_until") @db.Date
  /// reply_received | no_signer | override
  flags          String[]  @default([])
  stageChangedAt DateTime  @default(now()) @map("stage_changed_at")
  /// Set when the journey ends (SQL, disqualified, not pursued, suppressed).
  closedAt       DateTime? @map("closed_at")
  importBatchId  String?   @map("import_batch_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  createdById    String?   @map("created_by_id") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at")

  brand Brand      @relation(fields: [brandId], references: [id])
  moves LeadMove[]

  @@index([brandId])
  @@index([stage, lane])
  @@map("lead")
}

/// Every change to a lead's stage, lane or flags: who or what made it, why, and whether it was undone.
/// Rows are never changed except to mark them undone.
model LeadMove {
  id           String    @id @default(uuid()) @db.Uuid
  leadId       String    @map("lead_id") @db.Uuid
  /// The move or event, e.g. to_target, reply_interested, event.emailsSent, override, undo.
  moveKey      String    @map("move_key")
  /// person | system | override | undo
  kind         String
  fromStage    String?   @map("from_stage")
  fromLane     String?   @map("from_lane")
  fromUntil    DateTime? @map("from_until") @db.Date
  fromFlags    String[]  @default([]) @map("from_flags")
  toStage      String    @map("to_stage")
  toLane       String?   @map("to_lane")
  toUntil      DateTime? @map("to_until") @db.Date
  toFlags      String[]  @default([]) @map("to_flags")
  reasonCode   String?   @map("reason_code")
  reason       String?
  /// A buyer event's own id (e.g. the lemlist event id): the same event never moves a lead twice.
  eventKey     String?   @unique @map("event_key")
  actorId      String?   @map("actor_id") @db.Uuid
  actorLabel   String    @map("actor_label")
  at           DateTime  @default(now())
  undoneAt     DateTime? @map("undone_at")
  undoneById   String?   @map("undone_by_id") @db.Uuid
  /// On an undo row: the move it undid.
  undoOfId     String?   @map("undo_of_id") @db.Uuid
  /// For decisions (Target, SQL…): what the gates recommended at that moment, and whether the person decided
  /// otherwise (an override, with reasonCode and reason).
  recommendation String?
  isOverride     Boolean @default(false) @map("is_override")

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId, at])
  @@map("lead_move")
}

// ---------------------------------------------------------------- Background jobs

/// The job queue, in PostgreSQL (no Redis needed at ATM's volumes). A worker claims due jobs one at a time
/// (FOR UPDATE SKIP LOCKED, so several app instances never run the same job), retries failures with a growing
/// wait, and keeps every job with its result or error. Scheduled runs use `unique_key` so each run happens once.
model Job {
  id          String    @id @default(uuid()) @db.Uuid
  /// What to run, e.g. lanes.tick.
  name        String
  payload     Json      @default("{}")
  /// queued | running | done | failed (will retry) | dead (gave up)
  status      String    @default("queued")
  runAt       DateTime  @default(now()) @map("run_at")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  /// e.g. lanes.tick:2026-11-23, so a scheduled run is queued once however many app instances there are.
  uniqueKey   String?   @unique @map("unique_key")
  /// The handler's summary when it finished, e.g. "3 leads back from Nurture".
  result      String?
  lastError   String?   @map("last_error")
  lockedAt    DateTime? @map("locked_at")
  lockedBy    String?   @map("locked_by")
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  /// Who queued it by hand (Run now, Retry), if anyone.
  createdById String?   @map("created_by_id") @db.Uuid

  @@index([status, runAt])
  @@index([name, createdAt])
  @@map("job")
}

// ---------------------------------------------------------------- Gates

/// A gate: one check that decides the pipeline. Desk gates (01–03) decide Target; call gates (04–06) are
/// confirmed after the qualifying call. Edited in Settings → Gates; switched off rather than deleted.
model GateDefinition {
  code        String   @id
  name        String
  /// What the gate checks, shown next to it.
  checks      String   @default("")
  /// desk | call
  stage       String
  /// The check the system makes from the brand's own fields, to flag a value that disagrees: category |
  /// revenue_band | lane, or none.
  rule        String?
  /// Off: the gate isn't shown or counted for any lead (its values are kept).
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@map("gate_definition")
}

/// A gate's current value on one lead: pass, fail or unknown, and whether it applies (the checklist tick). Every
/// change is a gate_change row.
model GateResult {
  id                  String   @id @default(uuid()) @db.Uuid
  leadId              String   @map("lead_id") @db.Uuid
  gateCode            String   @map("gate_code")
  /// pass | fail | unknown (missing evidence is always unknown, and unknown never blocks)
  value               String   @default("unknown")
  /// Unticked: not needed for this brand, so it doesn't count in the recommendation (with a reason).
  applies             Boolean  @default(true)
  notApplicableReason String?  @map("not_applicable_reason")
  /// One line of evidence: where the value comes from.
  evidence            String   @default("")
  /// Free notes on this gate for this brand (what was found, what to check next). Changes are in the gate's history.
  note                String   @default("")
  /// default | auto (from the brand's details) | import | manual | call
  source              String   @default("default")
  setById             String?  @map("set_by_id") @db.Uuid
  setAt               DateTime @default(now()) @map("set_at")

  @@unique([leadId, gateCode])
  @@map("gate_result")
}

/// The history of a lead's gates: who changed which gate, from what to what, and why. Never changed.
model GateChange {
  id         String   @id @default(uuid()) @db.Uuid
  leadId     String   @map("lead_id") @db.Uuid
  gateCode   String   @map("gate_code")
  /// value | applies | evidence | note
  field      String
  before     String?
  after      String?
  reasonCode String?  @map("reason_code")
  reason     String?
  source     String
  actorId    String?  @map("actor_id") @db.Uuid
  actorLabel String   @map("actor_label")
  at         DateTime @default(now())

  @@index([leadId, at])
  @@map("gate_change")
}

// ---------------------------------------------------------------- Knowledge base (dossiers and facts)

/// A brand's research file (the dossier): a PDF or Word file uploaded by hand, or a link from the Brand Register
/// that the system fetches into storage. Files live in Amazon S3 (private bucket, encrypted); only the key is
/// kept here. Rows are archived, never deleted, and the stored file is never removed.
model Dossier {
  id            String    @id @default(uuid()) @db.Uuid
  brandId       String    @map("brand_id") @db.Uuid
  /// file (uploaded) | link (from the register or added by hand)
  kind          String
  /// What people see: the file name, or the link's name.
  title         String
  /// For links: the address as given.
  sourceUrl     String?   @map("source_url")
  /// The S3 object key, e.g. dossiers/<brand id>/<uuid>.pdf. Never built from the file name.
  fileKey       String?   @unique @map("file_key")
  fileName      String?   @map("file_name")
  /// pdf | docx | doc
  fileType      String?   @map("file_type")
  contentType   String?   @map("content_type")
  sizeBytes     Int?      @map("size_bytes")
  /// SHA-256 of the file: the same file isn't attached twice to one brand, and S3 checks it on upload.
  sha256        String?
  /// uploading | queued | fetching | stored | link_only (couldn't be fetched: kept as a link) | failed
  status        String
  /// Why a link couldn't be fetched, or why an upload failed.
  statusNote    String?   @map("status_note")
  fetchAttempts Int       @default(0) @map("fetch_attempts")
  /// upload | import | link
  origin        String
  importBatchId String?   @map("import_batch_id") @db.Uuid
  note          String    @default("")
  createdAt     DateTime  @default(now()) @map("created_at")
  createdById   String?   @map("created_by_id") @db.Uuid
  storedAt      DateTime? @map("stored_at")
  archivedAt    DateTime? @map("archived_at")
  archivedById  String?   @map("archived_by_id") @db.Uuid
  archiveReason String?   @map("archive_reason")
  /// For Google Docs/Drive links: the Google file id, so the same file isn't added twice to a brand.
  googleFileId  String?   @map("google_file_id")
  /// "Mark as checked": a person opened the dossier (with their own access) and confirmed it is the right, correct
  /// file. The person who added it may check it too; that is recorded as self-checked.
  checkedAt        DateTime? @map("checked_at")
  checkedById      String?   @map("checked_by_id") @db.Uuid
  checkedByLabel   String?   @map("checked_by_label")
  checkNote        String    @default("") @map("check_note")
  /// The version they read: the "Last edit" date shown in Google, or the file's date.
  checkVersionDate DateTime? @map("check_version_date") @db.Date
  selfChecked      Boolean   @default(false) @map("self_checked")

  brand Brand  @relation(fields: [brandId], references: [id])
  facts Fact[]

  @@index([brandId, archivedAt])
  @@index([sha256])
  @@index([brandId, googleFileId])
  @@map("dossier")
}

/// One field of the knowledge-base form (e.g. Home revenue, Markets live, Halal exposure). Edited in
/// Settings → Facts; the key and type never change once made, and fields are switched off rather than deleted.
model FactDefinition {
  key         String   @id
  label       String
  /// company | asia | regulatory | outreach
  groupCode   String   @map("group_code")
  help        String   @default("")
  /// text | long_text | number | usd | date | yes_no | choice | multi_choice
  type        String
  options     String[] @default([])
  /// Required facts must all be verified (and fresh) before the knowledge base is verified.
  required    Boolean  @default(false)
  /// Days a fact stays fresh after its evidence date; then it is flagged stale.
  refreshDays Int      @default(180) @map("refresh_days")
  /// A brand field that pre-fills this fact (homeRevenueUsd | revenueYear | asianMarketsLive), and that a
  /// Brand Register column for that field also fills on import.
  brandField  String?  @map("brand_field")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id") @db.Uuid

  facts Fact[]

  @@map("fact_definition")
}

/// One version of one fact about a brand. Entering a new value adds a new row and marks the old one superseded,
/// so nothing is overwritten and the history stays complete. Maker-checker: the person who entered a fact verifies
/// it only with "Verify own facts", and it is then marked self-verified. A database trigger refuses changes to the
/// value, source and evidence of a saved row, and refuses deletes.
model Fact {
  id              String    @id @default(uuid()) @db.Uuid
  brandId         String    @map("brand_id") @db.Uuid
  factKey         String    @map("fact_key")
  value           Json
  /// Where it comes from: dossier page or section, a link, a report.
  source          String
  /// From Lists → Fact source tiers (e.g. Company's own, Trusted third party, Estimate).
  sourceTierCode  String?   @map("source_tier_code")
  /// The dossier it was taken from, if any.
  dossierId       String?   @map("dossier_id") @db.Uuid
  /// The date of the evidence (the report, the page, the research).
  evidenceDate    DateTime  @map("evidence_date") @db.Date
  /// evidenceDate + the definition's refresh days: after this the fact is stale.
  refreshDue      DateTime  @map("refresh_due") @db.Date
  /// entered | verified | rejected
  status          String    @default("entered")
  /// manual | import
  origin          String    @default("manual")
  note            String    @default("")
  importBatchId   String?   @map("import_batch_id") @db.Uuid
  enteredById     String?   @map("entered_by_id") @db.Uuid
  enteredByLabel  String    @map("entered_by_label")
  enteredAt       DateTime  @default(now()) @map("entered_at")
  verifiedById    String?   @map("verified_by_id") @db.Uuid
  verifiedByLabel String?   @map("verified_by_label")
  verifiedAt      DateTime? @map("verified_at")
  /// Verified by the same person who entered it (allowed with "Verify own facts").
  selfVerified    Boolean   @default(false) @map("self_verified")
  rejectedById    String?   @map("rejected_by_id") @db.Uuid
  rejectedByLabel String?   @map("rejected_by_label")
  rejectedAt      DateTime? @map("rejected_at")
  rejectReason    String?   @map("reject_reason")
  /// Set when a newer version replaces it. The current fact is the one with no supersededAt: one per brand and key,
  /// kept so by locking the brand row while a fact is written.
  supersededAt    DateTime? @map("superseded_at")

  brand      Brand          @relation(fields: [brandId], references: [id])
  definition FactDefinition @relation(fields: [factKey], references: [key])
  dossier    Dossier?       @relation(fields: [dossierId], references: [id])

  @@index([brandId, factKey, enteredAt])
  @@index([status, refreshDue])
  @@map("fact")
}

/// Settings → Fields: whether a built-in field is required. Only fields the code allows to switch are stored, and
/// only once someone changes them (until then the code's default applies). Existing records aren't touched: the
/// rule applies when a record is added, imported, or when that field is edited.
model FieldRule {
  /// organisation | brand | product | person
  entity      String
  key         String
  required    Boolean
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@id([entity, key])
  @@map("field_rule")
}
