# Copy this file to .env and fill it in. Never commit .env.

# development | staging | production
APP_ENV=development
PORT=3000

# The web app's address (used in invite emails and for CORS).
FRONTEND_URL=http://localhost:5173

# PostgreSQL. Create the database first: createdb atm_crm
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atm_crm?schema=public

# Google sign-in: an OAuth 2.0 "Web application" client from Google Cloud Console.
# Authorised redirect URI (must match exactly): http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# Optional: only these Google Workspace domains may sign in (comma-separated). Empty = any invited Google account.
GOOGLE_ALLOWED_DOMAINS=

# The first admins, created by the seed with every permission (comma-separated emails).
SEED_ADMIN_EMAILS=sephy.mathew@staxlabs.in,tjc@bizinnox.com


# Sign-in session length in days, and how long an invite stays valid.
SESSION_DAYS=7
INVITE_DAYS=7

# Email for invites. "log" prints the email in the server console and keeps it in the outbox table.
# "smtp" sends it through the SMTP server below (for example Amazon SES SMTP).
MAIL_TRANSPORT=log
MAIL_FROM="ATM CRM <no-reply@yourcompany.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Background jobs run inside the app. Set to off on an instance that should not run them.
# JOBS_WORKER=off

# Dossier files (knowledge base): a PRIVATE Amazon S3 bucket. Singapore (ap-southeast-1) by default, for PDPA.
# See the README section "Dossier storage (S3)" for the bucket settings and the IAM policy.
S3_BUCKET=
S3_REGION=ap-southeast-1
# Keys of an IAM user that may only put and get objects in this bucket. On AWS servers (EC2, ECS), leave both
# empty and give the server an IAM role instead: no keys to leak.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: a KMS key for encryption at rest (empty = S3-managed AES-256).
# S3_KMS_KEY_ID=
# Optional: folder inside the bucket (default: the APP_ENV name, so staging and production never mix).
# S3_PREFIX=
# Only for an S3-compatible store in development (MinIO, LocalStack):
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true

# Google Calendar for booking pages (Settings → Booking pages → Connect Google Calendar). Uses the same Google
# client as sign-in. Add this exact address to the client's "Authorised redirect URIs" in Google Cloud Console:
GOOGLE_CALENDAR_CALLBACK_URL=http://localhost:3000/api/v1/calendar/google/callback
# Encrypts the stored calendar access. Required to connect a calendar. Make one with: openssl rand -hex 32
CALENDAR_ENC_KEY=
